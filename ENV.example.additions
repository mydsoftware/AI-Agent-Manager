# ---- Shared memory / RAG ----
MEMORY_ENABLED=true
MEMORY_BACKEND=sqlite
MEMORY_PATH=data/shared_memory.db

# ---- Circuit breaker & budget ----
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_RECOVERY_SECONDS=30
MAX_TASK_RETRIES=5
DEFAULT_TOKEN_BUDGET=50000
DEFAULT_COST_BUDGET_USD=1.0
DEFAULT_TIME_BUDGET_SECONDS=300
DAILY_GLOBAL_TOKEN_BUDGET=500000
DAILY_GLOBAL_COST_BUDGET_USD=10.0

# ---- Sandbox ----
SANDBOX_ENABLED=true
SANDBOX_BACKEND=subprocess
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_NETWORK=false
SANDBOX_ALLOW_DOCKER=false

# ---- HITL ----
HITL_ENABLED=true
HITL_EXPIRY_SECONDS=3600
HITL_AUTO_APPROVE_LOW=true

# ---- Multimodal ----
MULTIMODAL_ENABLED=true
MULTIMODAL_OUTPUT_DIR=asset_generation/output
MULTIMODAL_DEFAULT_PROVIDER=mock

# ---- Observability ----
OBSERVABILITY_ENABLED=true
OBSERVABILITY_PATH=data/traces.db
OTEL_ENABLED=false

# ---- Plugins ----
PLUGINS_ENABLED=true
PLUGINS_DIR=plugins
