# AI-Agent-Manager / Local LLM
# این فایل فقط نمونه است؛ مقادیر واقعی را commit نکنید.
LLM_PROVIDER=lmstudio
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_API_KEY=lm-studio
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2
LLM_CONTEXT_TOKENS=12288
LLM_CONTEXT_RESERVE_TOKENS=1024
LLM_FALLBACK_MODEL=qwen2.5-coder-7b

# Model routing overrides (اختیاری)
LLM_MODEL_PLANNER=qwen3.5-9b
LLM_MODEL_DEVELOPER=qwen3.5-9b
LLM_MODEL_CODER=qwen2.5-coder-7b
LLM_MODEL_RESEARCHER=qwen3.5-9b
LLM_MODEL_REVIEWER=qwen2.5-coder-7b
LLM_MODEL_TESTER=qwen2.5-coder-7b
LLM_MODEL_VISION=qwen3-vl-4b-instruct
LLM_MODEL_EMBEDDING=text-embedding-nomic-embed-text-v1.5

# API key برنامه Manager در صورت استفاده از HTTP API
AI_AGENT_MANAGER_API_KEY=کلید-قوی-خودتان-را-اینجا-تنظیم-کنید
