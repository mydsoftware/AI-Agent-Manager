# کلیدهای API را فقط در محیط اجرا یا GitHub Secrets تنظیم کنید.
AI_AGENT_MANAGER_API_KEY=your-strong-api-key-here
GITHUB_TOKEN=your-github-token-here

# ============================================================
# AI Gateway - Provider Priority (اولویت Providerها)
# ============================================================
AI_PROVIDER_PRIORITY=openrouter,freebuff,opencode,ollama

# ============================================================
# OpenRouter
# ============================================================
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TIMEOUT=90

# ============================================================
# Freebuff
# ============================================================
FREEBUFF_API_KEY=
FREEBUFF_BASE_URL=
FREEBUFF_MODEL=
FREEBUFF_TIMEOUT=90

# ============================================================
# OpenCode
# ============================================================
OPENCODE_BASE_URL=
OPENCODE_API_KEY=
OPENCODE_MODEL=
OPENCODE_TIMEOUT=90

# ============================================================
# Ollama (Local)
# ============================================================
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=
OLLAMA_TIMEOUT=120

# ============================================================
# Per-Agent Model Routing
# ============================================================
PLANNER_MODEL=
DEVELOPER_MODEL=
REVIEWER_MODEL=
TESTER_MODEL=
RESEARCHER_MODEL=
GAME_DESIGNER_MODEL=
GAME_DEVELOPER_MODEL=

# ============================================================
# Retry & Limits
# ============================================================
MAX_RETRIES=3
RETRY_BASE_DELAY=1.0
RETRY_MAX_DELAY=30.0
MAX_REQUESTS_PER_EXECUTION=100
MAX_TASK_RETRIES=5
MAX_CI_RETRIES=5

# ============================================================
# Legacy Providers (سازگاری با نسخه قبلی)
# ============================================================
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=
FREELLMAPI_BASE_URL=http://localhost:3001/v1
FREELLMAPI_API_KEY=

# ============================================================
# Deployment
# ============================================================
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
